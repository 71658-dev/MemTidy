<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MemTidy</AssemblyName>
    <Product>記憶體整理</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- A resident tool should itself stay small: workstation GC without the background GC thread -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Custom controls are built in code only, never in the WinForms designer -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- Regenerate with tools\make-icon.ps1 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- No .NET startup hooks: an environment variable must never be able to load extra code into MemTidy,
         least of all into the cache window, which runs as administrator. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- The installer window's administrator step: the same script install.ps1 reads, built into the exe -->
    <EmbeddedResource Include="AdminStep.ps1" LogicalName="AdminStep.ps1" />
  </ItemGroup>

</Project>
